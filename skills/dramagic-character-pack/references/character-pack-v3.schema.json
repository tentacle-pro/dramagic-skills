{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dramagic:character-pack:3.0",
  "title": "Dramagic character pack 3.0",
  "$comment": "String maxLength is Unicode code points. The authoritative Rust validator also enforces UTF-8 byte limits, unique character IDs, ZIP/path/media rules and resource budgets. JSON duplicate keys must be rejected before schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "author_id",
    "pack_id",
    "pack_name",
    "version",
    "characters"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "author_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "pack_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "pack_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "character_id",
          "ui_metadata",
          "payload"
        ],
        "properties": {
          "character_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "ui_metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gender",
              "title",
              "description",
              "tags",
              "catchphrase",
              "avatar_path",
              "fullbody_path",
              "accent_color"
            ],
            "properties": {
              "gender": {
                "enum": [
                  "male",
                  "female",
                  "other"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "tags": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "catchphrase": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "avatar_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^(?:[a-z0-9_-]+/)*[a-z0-9_-]+(?:[.][a-z0-9_-]+)*[.]webp$"
              },
              "fullbody_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^(?:[a-z0-9_-]+/)*[a-z0-9_-]+(?:[.][a-z0-9_-]+)*[.]webp$"
              },
              "accent_color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "role",
              "voice_id",
              "theme_color",
              "personality_tags",
              "base_instruction",
              "emotion_sprites"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "voice_id": {
                "enum": [
                  "Puck",
                  "Charon",
                  "Fenrir",
                  "Orus",
                  "Enceladus",
                  "Iapetus",
                  "Umbriel",
                  "Algieba",
                  "Algenib",
                  "Rasalgethi",
                  "Alnilam",
                  "Schedar",
                  "Pulcherrima",
                  "Achird",
                  "Zubenelgenubi",
                  "Sadachbia",
                  "Sadaltager",
                  "Zephyr",
                  "Kore",
                  "Leda",
                  "Aoede",
                  "Callirrhoe",
                  "Autonoe",
                  "Despina",
                  "Erinome",
                  "Laomedeia",
                  "Achernar",
                  "Gacrux",
                  "Vindemiatrix",
                  "Sulafat"
                ]
              },
              "theme_color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "personality_tags": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "base_instruction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "emotion_sprites": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "neutral",
                  "smile",
                  "angry",
                  "worried"
                ],
                "properties": {
                  "neutral": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "pattern": "^(?:[a-z0-9_-]+/)*[a-z0-9_-]+(?:[.][a-z0-9_-]+)*[.]webp$"
                  },
                  "smile": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "pattern": "^(?:[a-z0-9_-]+/)*[a-z0-9_-]+(?:[.][a-z0-9_-]+)*[.]webp$"
                  },
                  "angry": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "pattern": "^(?:[a-z0-9_-]+/)*[a-z0-9_-]+(?:[.][a-z0-9_-]+)*[.]webp$"
                  },
                  "worried": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "pattern": "^(?:[a-z0-9_-]+/)*[a-z0-9_-]+(?:[.][a-z0-9_-]+)*[.]webp$"
                  }
                }
              }
            }
          },
          "references": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "identity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^(?:[a-z0-9_-]+/)*[a-z0-9_-]+(?:[.][a-z0-9_-]+)*[.]webp$"
              }
            }
          }
        }
      }
    }
  }
}
